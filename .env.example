# ==============================================================================
# REACT FRONTEND CONFIGURATION (.env.example)
# Barangay DRRM Disaster Operations Console
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LARAVEL BACKEND API (Primary Operational Engine)
# ------------------------------------------------------------------------------
VITE_LARAVEL_API_URL=http://localhost:8000/api/v1
VITE_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE DIRECT INTEGRATION KEYS
# Where to find them:
# In Supabase Dashboard -> Your Project -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Public anon/public key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=
